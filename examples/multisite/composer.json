{
  "name": "kleinweb/example-multisite",
  "description": "Example multisite project using kleinweb/lib tenancy",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "repositories": [
    {
      "name": "kleinweb-lib",
      "type": "path",
      "url": "../..",
      "options": {
        "symlink": true
      }
    },
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": "^8.3",
    "composer/installers": "^2.3",
    "kleinweb/lib": "@dev",
    "roots/acorn": "^6.0",
    "wikimedia/composer-merge-plugin": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "wikimedia/composer-merge-plugin": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "installer-paths": {
      "wp-content/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "merge-plugin": {
      "include": [
        "wp-content/themes/*/composer.json",
        "wp-content/plugins/kleinweb-site-*/composer.json"
      ],
      "recurse": false,
      "replace": false,
      "merge-dev": false,
      "merge-extra": false,
      "merge-scripts": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
