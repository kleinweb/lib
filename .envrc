# Ensure the nix-direnv library functions are available.
# <https://github.com/nix-community/nix-direnv>
if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-Di03ad3a0ueGi6CGrfhrQzyGdQIg9APXIPCAMNQgWYM="
fi

{ # PRJ Base Directory Specification: https://github.com/numtide/prj-spec
  # shellcheck source=/dev/null
  source "$(
    fetchurl \
      "https://raw.githubusercontent.com/numtide/prj-spec/9b0ffcd0fddcb261bcd73ad9dad18a096760b4a0/contrib/direnv" \
      "sha256-54YaaGly6Q0E8GhFT9fB/h9tN1PDERo2/4R4X0Pdi/c="
  )"
}

watch_file .config/devshells.nix
watch_file .config/git-hooks.nix
watch_file .env

use flake

# Provide stable tool paths for editor integrations.
if has php; then
  ln -sf "$(which php)" "${PRJ_BIN_HOME}/php"
fi
